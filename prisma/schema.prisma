generator client {
  provider = "prisma-client-js"
}
datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model User {
    id          Int      @id @default(autoincrement())
    email       String   @unique
    idCard      String?  @unique
    phoneNumber String? @unique
    password    String  
    name        String?
    deceased    Deceased[]
    role        Role      @default(user)
    createdAt   DateTime @default(now())
    updatedAt   DateTime @updatedAt
}

model Garden {
  id          String      @id @default(uuid())  
  name        String @unique
  address     String
  imageUrl    String
  type        GardenType
  feedback    Feedback[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Feedback {
  id          Int      @id @default(autoincrement())  
  content     String
  email       String
  about       AboutFeedback
  garden      Garden   @relation(fields: [gardenId], references: [id])
  gardenId    String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Graveyard {
  id              String      @id @default(uuid())
  name            String
  mapsUrl         String
  address         String
  type            GraveyardType
  imageUrl        String
  religion        String
  additionalInfo  Json
  numberOfGrave   Int
  deceased        Deceased[]
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model Deceased {
  id              String      @id @default(uuid())
  name            String
  fatherInLawName String
  idCard          String 
  Gender          Gender
  placeOfBirth    String
  dateOfBirth     DateTime
  dateOfDeath     DateTime
  burialDate      DateTime
  graveyard       Graveyard @relation(fields: [graveyardId], references: [id])
  graveyardId     String
  additionalInfo  Json
  addressDetail   AddressDetail?
  additionalFile  AdditionalFile?
  user            User?    @relation(fields: [userId], references: [id])
  userId          Int?
  status          Status?   @default(belum_terverifikasi)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model Heirs {
  id           String      @id @default(uuid())
  name         String
  idCard       String     
  phoneNumber  String      
  job          String
  addressDetail AddressDetail?
  additionalFile AdditionalFile?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model AddressDetail {
  id            String      @id @default(uuid())
  homeNumber    String
  street        String
  rt            String
  rw            String
  province      String
  city          String
  district      String
  neighborhood  String
  deceased      Deceased?     @relation(fields: [deceasedId], references: [id])
  deceasedId    String?       @unique
  heirs         Heirs?  @relation(fields: [heirsId], references: [id])
  heirsId       String? @unique
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model AdditionalFile {
  id                         String      @id @default(uuid())
  ktpUrl                     String?
  certificateUrl             String?
  incapabilityCertificateUrl String?
  deceased                   Deceased?     @relation(fields: [deceasedId], references: [id])
  deceasedId                 String?       @unique
  heirs                      Heirs?  @relation(fields: [heirsId], references: [id])
  heirsId                    String? @unique
  createdAt                  DateTime @default(now())
  updatedAt                  DateTime @updatedAt
}

enum Role {
  admin
  user
}

enum Status {
  terverifikasi
  belum_terverifikasi
}

enum Gender {
  male
  female
}

enum AboutFeedback {
  infrastructural_facilities
  service
  location
  advice
}
enum GraveyardType {
  biasa
  tumpang
  covid
}

enum GardenType {
  pemda
  square
}